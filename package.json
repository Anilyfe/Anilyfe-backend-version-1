{
  "name": "anilyfe-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ANILyfe marketplace backend - API-first V1",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "admin:promote": "node scripts/promote-admin.js",
    "admin:super-promote": "node scripts/promote-super-admin.js",
    "admin:create": "node scripts/create-admin.js",
    "test": "node --test",
    "lint:syntax": "find src scripts -name \"*.js\" -print0 | xargs -0 -n1 node --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@identifyorg/node-sdk": "^0.5.0",
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "prisma": "^6.15.0",
    "resend": "^6.33.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
